# Supabase (só a chave ANON — nunca a service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Código impresso no folheto dentro da caixa (libera o app ao receber o frasco).
# Vários códigos separados por vírgula. Maiúsculas/minúsculas não importam.
NEXT_PUBLIC_CODIGO_ACTIVACION=BMAX
# WhatsApp da Camila (só dígitos, com DDI)
NEXT_PUBLIC_WHATSAPP=5554920011946
# Grupo de motivação (perfis de roteiro): "demo" = ligado, "off" = só usuárias reais
NEXT_PUBLIC_GRUPO_MODO=demo
